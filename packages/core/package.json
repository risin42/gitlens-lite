{
	"name": "@gitkraken/core-gitlens",
	"description": "GitLens core — shared local Git primitives",
	"version": "0.5.113",
	"license": "SEE LICENSE IN LICENSE",
	"author": {
		"name": "GitKraken",
		"url": "https://gitkraken.com"
	},
	"homepage": "https://github.com/gitkraken/vscode-gitlens/tree/main/packages/core",
	"bugs": {
		"url": "https://github.com/gitkraken/vscode-gitlens/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/gitkraken/vscode-gitlens.git",
		"directory": "packages/core"
	},
	"engines": {
		"node": ">= 24"
	},
	"type": "module",
	"sideEffects": false,
	"publishConfig": {
		"provenance": false
	},
	"files": [
		"dist",
		"src",
		"LICENSE",
		"README.md",
		"CHANGELOG.md",
		"docs"
	],
	"imports": {
		"#env/*.js": {
			"node": {
				"types": "./dist/utils/env/node/*.d.ts",
				"default": "./dist/utils/env/node/*.js"
			},
			"default": {
				"types": "./dist/utils/env/browser/*.d.ts",
				"default": "./dist/utils/env/browser/*.js"
			}
		}
	},
	"exports": {
		"./package.json": "./package.json",
		"./git-cli/cliGitProvider.js": {
			"types": "./dist/git-cli/cliGitProvider.d.ts",
			"default": "./dist/git-cli/cliGitProvider.js"
		},
		"./git-cli/exec/*.js": {
			"types": "./dist/git-cli/exec/*.d.ts",
			"default": "./dist/git-cli/exec/*.js"
		},
		"./git-cli/parsers/*.js": {
			"types": "./dist/git-cli/parsers/*.d.ts",
			"default": "./dist/git-cli/parsers/*.js"
		},
		"./git-cli/providers/*.js": {
			"types": "./dist/git-cli/providers/*.d.ts",
			"default": "./dist/git-cli/providers/*.js"
		},
		"./git-cli/service.js": {
			"types": "./dist/git-cli/service.d.ts",
			"default": "./dist/git-cli/service.js"
		},
		"./git/cache.js": {
			"types": "./dist/git/cache.d.ts",
			"default": "./dist/git/cache.js"
		},
		"./git/context.js": {
			"types": "./dist/git/context.d.ts",
			"default": "./dist/git/context.js"
		},
		"./git/errors.js": {
			"types": "./dist/git/errors.d.ts",
			"default": "./dist/git/errors.js"
		},
		"./git/features.js": {
			"types": "./dist/git/features.d.ts",
			"default": "./dist/git/features.js"
		},
		"./git/gitHealth.js": {
			"types": "./dist/git/gitHealth.d.ts",
			"default": "./dist/git/gitHealth.js"
		},
		"./git/models/*.js": {
			"types": "./dist/git/models/*.d.ts",
			"default": "./dist/git/models/*.js"
		},
		"./git/parsers/*.js": {
			"types": "./dist/git/parsers/*.d.ts",
			"default": "./dist/git/parsers/*.js"
		},
		"./git/providers/*.js": {
			"types": "./dist/git/providers/*.d.ts",
			"default": "./dist/git/providers/*.js"
		},
		"./git/providers/shared/*.js": {
			"types": "./dist/git/providers/shared/*.d.ts",
			"default": "./dist/git/providers/shared/*.js"
		},
		"./git/remotes/*.js": {
			"types": "./dist/git/remotes/*.d.ts",
			"default": "./dist/git/remotes/*.js"
		},
		"./git/repositoryService.js": {
			"types": "./dist/git/repositoryService.d.ts",
			"default": "./dist/git/repositoryService.js"
		},
		"./git/run.types.js": {
			"types": "./dist/git/run.types.d.ts",
			"default": "./dist/git/run.types.js"
		},
		"./git/service.js": {
			"types": "./dist/git/service.d.ts",
			"default": "./dist/git/service.js"
		},
		"./git/utils/*.js": {
			"types": "./dist/git/utils/*.d.ts",
			"default": "./dist/git/utils/*.js"
		},
		"./git/watching/*.js": {
			"types": "./dist/git/watching/*.d.ts",
			"default": "./dist/git/watching/*.js"
		},
		"./ipc/discovery.js": {
			"types": "./dist/ipc/discovery.d.ts",
			"default": "./dist/ipc/discovery.js"
		},
		"./ipc/ipcServer.js": {
			"types": "./dist/ipc/ipcServer.d.ts",
			"default": "./dist/ipc/ipcServer.js"
		},
		"./utils/*.js": {
			"types": "./dist/utils/*.d.ts",
			"default": "./dist/utils/*.js"
		},
		"./utils/decorators/*.js": {
			"types": "./dist/utils/decorators/*.d.ts",
			"default": "./dist/utils/decorators/*.js"
		},
		"./utils/env/browser/*.js": null,
		"./utils/env/node/*.js": null,
		"./utils/env/node/exec.js": {
			"types": "./dist/utils/env/node/exec.d.ts",
			"default": "./dist/utils/env/node/exec.js"
		},
		"./utils/env/node/platform.js": {
			"types": "./dist/utils/env/node/platform.d.ts",
			"default": "./dist/utils/env/node/platform.js"
		},
		"./utils/keys/chord.js": {
			"types": "./dist/utils/keys/chord.d.ts",
			"default": "./dist/utils/keys/chord.js"
		},
		"./utils/keys/keybinding.js": {
			"types": "./dist/utils/keys/keybinding.d.ts",
			"default": "./dist/utils/keys/keybinding.js"
		}
	},
	"dependencies": {
		"fast-string-truncated-width": "catalog:",
		"ignore": "catalog:",
		"vscode-uri": "catalog:"
	},
	"scripts": {
		"build": "node scripts/bundle.mjs",
		"bundle": "node scripts/bundle.mjs",
		"clean": "pnpx rimraf --glob dist src LICENSE *.tgz",
		"prepack": "node scripts/bundle.mjs"
	}
}
