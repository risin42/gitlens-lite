{
	"name": "@gitlens/git-cli",
	"description": "GitLens Git CLI package",
	"version": "0.0.1",
	"license": "SEE LICENSE IN LICENSE",
	"private": true,
	"type": "module",
	"sideEffects": false,
	"exports": {
		"./cliGitProvider.js": {
			"types": "./dist/cliGitProvider.d.ts",
			"default": "./dist/cliGitProvider.js"
		},
		"./service.js": {
			"types": "./dist/service.d.ts",
			"default": "./dist/service.js"
		},
		"./exec/*.js": {
			"types": "./dist/exec/*.d.ts",
			"default": "./dist/exec/*.js"
		},
		"./providers/*.js": {
			"types": "./dist/providers/*.d.ts",
			"default": "./dist/providers/*.js"
		},
		"./parsers/*.js": {
			"types": "./dist/parsers/*.d.ts",
			"default": "./dist/parsers/*.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -b",
		"clean": "pnpx rimraf --glob dist out **/tsconfig*.tsbuildinfo",
		"clean:all": "pnpm run clean && pnpm run clean:deps",
		"clean:deps": "pnpx rimraf --glob **/node_modules",
		"clean:lint": "pnpx rimraf --glob **/tsconfig*.tsbuildinfo"
	},
	"dependencies": {
		"@gitlens/git": "workspace:*",
		"@gitlens/utils": "workspace:*"
	},
	"devDependencies": {
		"typescript": "catalog:"
	}
}
